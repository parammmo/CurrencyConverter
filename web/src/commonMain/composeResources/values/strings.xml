<resources>
    <!-- Kopie von app/src/main/res/values/strings.xml. Zwei Anpassungen für
         Compose-Multiplatform-Resources: Platzhalter müssen indiziert sein
         (%1$d statt %d), und Apostrophe brauchen kein Escaping. -->
    <!--
      Standardsprache der App ist Englisch; die deutschen Texte liegen in
      values-de/. Android wählt anhand der Gerätesprache aus und fällt auf
      diese Datei zurück, wenn es für die Sprache keine Übersetzung gibt.
    -->
    <string name="app_name">Currency Converter</string>

    <!-- Zustände -->
    <string name="error_rates_load_failed">Couldn’t load rates</string>
    <string name="action_try_again">Try again</string>

    <!-- Fußzeile -->
    <string name="rate_line">1 %1$s = %2$s %3$s</string>
    <string name="rate_unavailable">No rate available</string>

    <!--
      Pflichtangabe: Die Open-Access-API von ExchangeRate-API darf nur mit
      sichtbarer Namensnennung genutzt werden. Nicht entfernen.
    -->
    <string name="attribution">Rates by ExchangeRate-API</string>

    <!--
      "Just now" heißt hier "aktuell", nicht "vor einer Sekunde": Solange der
      Cache innerhalb der TTL liegt, gelten die Kurse als frisch.
    -->
    <string name="rates_just_now">Just now</string>
    <string name="rates_offline">Offline · %1$s</string>

    <plurals name="rates_age_hours">
        <item quantity="one">%1$d hour ago</item>
        <item quantity="other">%1$d hours ago</item>
    </plurals>
    <plurals name="rates_age_days">
        <item quantity="one">%1$d day ago</item>
        <item quantity="other">%1$d days ago</item>
    </plurals>

    <!-- Währungsauswahl (Bottom-Sheet) -->
    <string name="picker_search_placeholder">Search currency</string>
    <string name="picker_recent">Recently used</string>
    <string name="picker_all">All currencies</string>
    <string name="picker_no_match">No currency found for “%1$s”</string>

    <!-- Nur für Screenreader, nicht sichtbar -->
    <string name="cd_swap_currencies">Swap currencies</string>
    <string name="cd_refresh_rates">Refresh rates</string>
    <string name="cd_select_currency">Select currency, currently %1$s</string>
    <string name="cd_switch_to_light">Switch to light theme</string>
    <string name="cd_switch_to_dark">Switch to dark theme</string>
    <string name="cd_clear">Clear</string>
    <string name="cd_backspace">Delete last digit</string>
    <string name="cd_clear_search">Clear search</string>
    <string name="cd_selected">Currently selected</string>
</resources>
