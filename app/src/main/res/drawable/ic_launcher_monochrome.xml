<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrom-Ebene für "Themed Icons" (Android 13+): Aktiviert der Nutzer
  getönte Icons, färbt das System diese Silhouette passend zum Hintergrundbild
  ein und ignoriert unsere Farben. Nur die Form zählt.

  Nachgebaut aus ic_launcher_foreground.png, damit beide dasselbe Motiv zeigen:
  zwei überlappende Münzen — vorne ein Ring, dahinter eine volle Scheibe.
  Gemessene Geometrie (108dp-Leinwand):
    Ring   Mittelpunkt 45,6 / 54   außen r=16,6   innen r=7,1
    Scheibe Mittelpunkt 64,9 / 54   r=16,9

  Weil beide Formen in derselben Farbe gezeichnet werden, würden sie an der
  Überlappung zu einem Klumpen verschmelzen. Deshalb ist aus der hinteren
  Scheibe ein etwas größerer Kreis an der Position des Rings ausgestanzt — das
  ergibt die sichtbare Lücke, die im Farb-Icon der weiße Rand übernimmt.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Hintere Scheibe, vorne ausgestanzt (evenOdd = Überlappung wird Loch) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M48.0,54 a16.9,16.9 0 1,0 33.8,0 a16.9,16.9 0 1,0 -33.8,0 Z
                          M27.0,54 a18.6,18.6 0 1,0 37.2,0 a18.6,18.6 0 1,0 -37.2,0 Z" />

    <!-- Vorderer Ring -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M29.0,54 a16.6,16.6 0 1,0 33.2,0 a16.6,16.6 0 1,0 -33.2,0 Z
                          M38.5,54 a7.1,7.1 0 1,0 14.2,0 a7.1,7.1 0 1,0 -14.2,0 Z" />
</vector>
